public class Tabuada {

    public static void main(String[] args) {

        for (int tab = 0; tab <= 10; tab++) {

            for (int i = 0; i <= 10; i++) {
                int resultado = tab * i; 
                System.out.printf("tab %d x %d = %d%n", tab, i, resultado);
            }
            System.out.println(); 
        }
    }
}
