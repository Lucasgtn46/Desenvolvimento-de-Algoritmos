package com.mycompany.soma_s;
import java.util.Scanner;
/**
 *
 * @author Lucas S.Rodrigues
 */
public class Soma_S {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Digite um valor inteiro e positivo (n): ");
        int n = scanner.nextInt();

        // Verifica se o valor é positivo
        if (n <= 0) {
            System.out.println("Por favor, insira um número inteiro positivo.");
            return;
        }

        double soma = 0.0;

        // Calcula a soma
        for (int i = 1; i <= n; i++) {
            soma += 1.0 / i; // Soma 1/i à soma total
        }

        // Mostra o resultado
        System.out.printf("A soma S = 1 + 1/2 + 1/3 + ... + 1/%d é: %.6f%n", n, soma);

        scanner.close();
    }
}
