package com.mycompany.mediamaiornota;
import java.util.Scanner;
/**
 *
 * @author Lucas S.Rodrigues
 */
public class MediaMaiorNota {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        double somaNotas = 0.0; // Soma das notas
        double maiorNota = Double.NEGATIVE_INFINITY;
        int contador = 0; 

        while (contador < 10) {
            System.out.print("Digite a nota do aluno " + (contador + 1) + ": ");
            double nota = scanner.nextDouble(); 

            somaNotas += nota;
            if (nota > maiorNota) {
                maiorNota = nota; 
            }

            contador++; 
        }

        double media = somaNotas / 10;

        System.out.printf("A média da turma é: %.2f%n", media);
        System.out.printf("A maior nota obtida foi: %.2f%n", maiorNota);

        scanner.close();
    }
}
